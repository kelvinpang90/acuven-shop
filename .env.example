# 复制成 .env 再改。.env 已被 .gitignore 忽略；本文件只放变量名与明显的示例值，
# 绝不写真实凭据、主机名、IP 或服务器路径。配置项定义见 app/core/config.py。

# 本项目独立库的连接串（共享 MySQL 里的本项目库，账号只授权本库）。只有 alembic 用到。
# 密码里不要出现 @ : / #，它们会把连接串切错位置。
SHOP_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

# 共享 Redis 里分给本项目的独立库（末尾数字是库编号，由运营者分配）。查单等接口的短时限流计数存在这里；
# 留空或连不上时这些接口返回暂不可用，商品浏览不受影响。由 SHOP-TASK-026 接入。
SHOP_REDIS_URL=redis://HOST:6379/DBNUMBER

# 短信验证（Twilio Verify）与发送前的人机挑战（Cloudflare Turnstile）。留空即未配置：发短信一律按停发处理。
# 接口地址与凭据都由运营者在服务器私有配置里填写。由 SHOP-TASK-067 接入。
SHOP_TWILIO_ACCOUNT_SID=ACCOUNT_SID
SHOP_TWILIO_AUTH_TOKEN=AUTH_TOKEN
SHOP_TWILIO_VERIFY_SERVICE_SID=VERIFY_SERVICE_SID
SHOP_TWILIO_VERIFY_BASE_URL=https://VERIFY_API_HOST
SHOP_TURNSTILE_SECRET_KEY=TURNSTILE_SECRET
SHOP_TURNSTILE_VERIFY_URL=https://TURNSTILE_VERIFY_HOST/PATH

# 短信每日总量与费用预算（金额是整数微美元，1 美元 = 1000000）。单次最高费用为 0 即未配置，发往该国的短信停发。
# 默认值按 Kelvin 2026-10-08 的决定。由 SHOP-TASK-068 接入。
SHOP_SMS_DAILY_COUNT_LIMIT=200
SHOP_SMS_DAILY_COST_LIMIT_MICRO_USD=20000000
SHOP_SMS_MAX_COST_MICRO_USD_MY=0
SHOP_SMS_MAX_COST_MICRO_USD_SG=0

# 短信发送限流（Redis 固定窗口）。默认值按 Kelvin 2026-10-08 的决定；按国家的每日上限直接取 SHOP_SMS_DAILY_COUNT_LIMIT。由 SHOP-TASK-069 接入。
SHOP_SMS_PHONE_LIMIT_PER_MINUTE=1
SHOP_SMS_PHONE_LIMIT_PER_HOUR=5
SHOP_SMS_PHONE_LIMIT_PER_DAY=10
SHOP_SMS_SOURCE_LIMIT_PER_HOUR=10

# SHOP_GIT_SHA 不在这里配：镜像构建时由 Dockerfile 的 GIT_SHA 构建参数注入。
